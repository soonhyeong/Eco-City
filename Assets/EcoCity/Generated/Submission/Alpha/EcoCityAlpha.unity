--- !u!114 &1703101341
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 1703101338}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 5f7201a12d95ffc409449d95f23cf332, type: 3}
  m_Name: 
  m_EditorClassIdentifier: UnityEngine.UI::UnityEngine.UI.Text
  m_Material: {fileID: 0}
  m_Color: {r: 0.09, g: 0.22, b: 0.24, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_FontData:
    m_Font: {fileID: 12800000, guid: 114b771ae79aaa840a69ed05bdbc56ba, type: 3}
    m_FontSize: 21
    m_FontStyle: 0
    m_BestFit: 0
    m_MinSize: 10
    m_MaxSize: 40
    m_Alignment: 0
    m_AlignByGeometry: 0
    m_RichText: 0
    m_HorizontalOverflow: 0
    m_VerticalOverflow: 1
    m_LineSpacing: 1
  m_Text: "WASD / \uBC29\uD5A5\uD0A4: \uC774\uB3D9\n\uB9C8\uC6B0\uC2A4: \uC8FC\uBCC0
    \uC0B4\uD3B4\uBCF4\uAE30\nE: \uC870\uC900\uD55C \uBB3C\uCCB4 \uC9D1\uAE30 \xB7
    \uCC98\uB9AC \xB7 \uBC30\uCD9C \xB7 NPC \uB3C4\uC6C0\nEsc: \uBA54\uB274 \xB7
    H: \uC774 \uC548\uB0B4 \uB2E4\uC2DC \uBCF4\uAE30\n\n1. \uC55E\uCABD \uC5F0\uC2B5\uD488\uC744
    \uC8FC\uC6CC \uC0C1\uD0DC\uB97C \uD655\uC778\uD574\uC694.\n2. \uD544\uC694\uD55C
    \uACBD\uC6B0 \uC67C\uCABD \uC900\uBE44 \uAD6C\uC5ED\uC744 \uC774\uC6A9\uD574\uC694.\n3.
    \uB05D\uCABD \uC218\uAC70\uD568 \uC774\uB984\uC744 \uBCF4\uACE0 \uBC30\uCD9C\uD574\uC694.\n4.
    \uAE30\uBCF8 3\uAC1C \u2192 \uC0C1\uD0DC 2\uAC1C \u2192 \uBCF5\uD569 1\uAC1C
    \uC21C\uC11C\uC608\uC694.\n5. \uB3C4\uC6B0\uBBF8 \uB610\uB294 \uBA54\uB274\uC5D0\uC11C
    \uB3C4\uC6C0\uC744 \uC694\uCCAD\uD574\uC694.\n\n\uC0C9\uC0C1\uC740 \uAC8C\uC784
    \uC18D \uAD6C\uBD84\uC774\uC5D0\uC694. \uACF5\uC2DD \uC218\uAC70\uD568 \uC0C9
    \uAE30\uC900\uC774 \uC544\uB2C8\uC5D0\uC694.\n\uC774 \uACF5\uC6D0\uC758 6\uAC1C
    \uC5F0\uC2B5\uD488\uC740 \uAC00\uC0C1 \uADDC\uCE59\uC774\uC5D0\uC694. \uC2E4\uC81C
    \uBB3C\uAC74\uC740 \uC7AC\uC9C8 \uD45C\uC2DC\uC640 \uC9C0\uC5ED \uC548\uB0B4\uB97C
    \uD655\uC778\uD574\uC694.\n\uBCF5\uD569 \uC7AC\uC9C8\uC774 \uBAA8\uB450 \uC77C\uBC18
    \uC4F0\uB808\uAE30\uB294 \uC544\uB2C8\uBA70, \uC138\uCC99\uB9CC\uC73C\uB85C \uBAA8\uB4E0
    \uC624\uC5FC\uD488\uC744 \uC7AC\uD65C\uC6A9\uD560 \uC218\uB294 \uC5C6\uC5B4\uC694.\n\n\uC815\uB2F5\uB960:
    \uC131\uACF5\uD55C \uBC30\uCD9C / \uC804\uCCB4 \uBC30\uCD9C \uC2DC\uB3C4\n\uBAA8\uC758
    \uAE68\uB057\uD568: \uC5F0\uC2B5\uD488\uC744 \uBC30\uCD9C\uD55C \uBE44\uC728\n\uBAA8\uC758
    \uC624\uC5FC\uB3C4: \uB0A8\uC740 \uBB3C\uCCB4\uC640 \uC624\uB2F5 \uC774\uB825\uC744
    \uBC18\uC601\uD55C \uAC8C\uC784 \uC9C0\uD45C\n\uC2E4\uC81C \uD658\uACBD \uD1B5\uACC4\uC640\uB294
    \uB2EC\uB77C\uC694.\n\n\uAE00\uAF34: \uB098\uB214\uACE0\uB515 \xB7 NAVER \xB7
    SIL Open Font License 1.1"
